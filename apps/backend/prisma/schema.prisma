generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ExpoLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String   // e.g., "Products", "Bulk", "Partnership", "Other"
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(USER)
  metadata     Json?      
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  sessions     Session[]
  cart         Cart[]
  orders       Order[]   
  addresses    Address[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  slug        String     @unique
  imageUrl    String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  sku            String?     @unique
  price          Int
  compareAtPrice Int?
  inventory      Int         @default(0)
  weight         Float?
  isAvailable    Boolean     @default(true)
  featured       Boolean     @default(false)
  categoryId     String?
  userId         String?
  productType    ProductType
  strainType     StrainType?
  cbdContent     Float?
  thcContent     Float?
  size           String?
  tags           String[]
  images         String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  category       Category?   @relation(fields: [categoryId], references: [id])
  user           User?       @relation(fields: [userId], references: [id])
  items          CartItem[]
  orderItems     OrderItem[]

  @@index([isAvailable])
  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Cart {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   // e.g., "Home" or "Work"
  street     String
  city       String
  postalCode String
  country    String   @default("South Africa")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]  // orders shipped to this address

  @@map("addresses")
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  total            Float
  status           String      @default("pending")
  stripeSessionId  String?     @unique
  shippingAddressId String?     // snapshot of the address used
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  trackingNumber   String?      // Courier Guy tracking number
  courierStatus    String?      // "pending", "in_transit", "delivered"
  courierUpdatedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float    // price at time of purchase

  @@map("order_items")
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  FLOWER
  CONCENTRATE
  EDIBLE
  TOPICAL
  TINCTURE
  CAPSULE
  ACCESSORY
  MERCHANDISE
}

enum StrainType {
  SATIVA
  INDICA
  HYBRID
}